<Window x:Class="Swd.Mvvm.View.vMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Swd.Mvvm.View"
        mc:Ignorable="d"
        Title="vMain" Height="450" Width="1280">

    <Window.Resources>

        <DataTemplate x:Key="templatePerson">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="75*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Image/D.jpg" Width="100" Height="100"/>
                <StackPanel Margin="5" HorizontalAlignment="Stretch" Grid.Column="1">
                    <TextBlock Foreground="Red" FontSize="20" Text="{Binding DisplayName}" TextAlignment="Left" />
                    <TextBlock Foreground="Black" FontSize="12" Text="{Binding Email}" TextAlignment="Left" />
                    <TextBlock Foreground="Black" FontSize="12" Text="{Binding Phone}" TextAlignment="Left" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        
    </Window.Resources>



    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="75*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Column="0" Grid.Row="0">
            <ListBox x:Name="lstPersons" ItemsSource="{Binding Persons}" ItemTemplate="{DynamicResource templatePerson}" SelectedItem="{Binding SelectedPerson}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="0" Margin="10">
            <Label Content="Ausgewählte Person" Style="{StaticResource styHeadline}" />
            <TextBox x:Name="Id" Text="{Binding SelectedPerson.Id}" />
            <TextBox x:Name="Lastname" Text="{Binding SelectedPerson.Lastname}" />
            <TextBox x:Name="Firstname" Text="{Binding SelectedPerson.Firstname}" />
            <TextBox x:Name="Email" Text="{Binding SelectedPerson.Email}" />
            <TextBox x:Name="Phone" Text="{Binding SelectedPerson.Phone}" />
            <Button x:Name="btnSavePerson" Content="Personendaten speichern" Click="btnSavePerson_Click" />
        </StackPanel>
        <StatusBar Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
            <Label Content="Letzte Aktualisierung:" />
            <Label Content="{Binding LastUpdate}" />


        </StatusBar>
    </Grid>
    
</Window>
