@model MovieDto

@{
    ViewData["Title"] = "Movies";
    ViewBag.LocaleName = System.Threading.Thread.CurrentThread.CurrentCulture.Name;
}


<h1>@BasicRes.Edit</h1>

<h4>Movie</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" value="@Model.Id" name="Id" />
            <input type="hidden" value="PUT" name="_method" />
            <div class="form-group row mb-3">
                <label for="@nameof(Model.Title)" class="col-sm-2 col-form-label">@BasicRes.Title</label>
                <div class="col-sm-10">
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row mb-3">
                <label asp-for="GenreId" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-3">
                    <select asp-for="GenreId" class="form-control" asp-items="ViewBag.GenreId"></select>
                    <span asp-validation-for="GenreId" class="text-danger"></span>
                </div>
                <label asp-for="MediumTypeCode" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-2">
                    <select asp-for="MediumTypeCode" class="form-control" asp-items="ViewBag.MediumTypeCode"></select>
                    <span asp-validation-for="MediumTypeCode" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row mb-3">
                <label asp-for="Price" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-1">
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <label asp-for="ReleaseDate" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-2">
                    <input type="date" asp-for="ReleaseDate" class="form-control" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>
                <label asp-for="Rating" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-2">
                    <select asp-for="Rating" class="form-control" asp-items="ViewBag.Ratings"></select>
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-9 offset-sm-2">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">@BasicRes.BackToList</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}