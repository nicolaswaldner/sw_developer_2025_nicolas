<Window x:Class="GuiEntwurf.fStart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuiEntwurf"
        mc:Ignorable="d"
        Title="fStart" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        
        <Button x:Name="btnDefaultControls" Content="Standard Controls" Grid.Row="0" Grid.Column="1" Margin="10" Click="btnDefaultControls_Click"/>
        <Button x:Name="btnExtendedControls" Content="Erweiterte Controls" Grid.Row="1" Grid.Column="1" Margin="10" Click="btnExtendedControls_Click"/>
        <Button x:Name="btnBinding" Content="Binding" Grid.Row="2" Grid.Column="1" Margin="10" Click="btnBinding_Click"/>
        <Button x:Name="btnDataBinding" Content="Databinding" Grid.Row="3" Grid.Column="1" Margin="10" Click="btnDataBinding_Click"/>
        

    </Grid>
</Window>
