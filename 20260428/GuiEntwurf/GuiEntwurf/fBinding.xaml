<Window x:Class="GuiEntwurf.fBinding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuiEntwurf"
        mc:Ignorable="d"
        Title="fBinding" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Slider Grid.Row="0" x:Name="sliFontSize" Minimum="10" Maximum="100" Value="24" />
        <Slider Grid.Row="1" x:Name="sliRotation" Minimum="0" Maximum="360" Value="0"/>

        <TextBlock Grid.Row="2" 
                   x:Name="lblDisplaytext" 
                   Text="Anzeigetext" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   FontSize="{Binding Value, ElementName=sliFontSize}"
                   RenderTransformOrigin="0.5,0.5"
                   >
                    <TextBlock.RenderTransform>
                       <TransformGroup>
                           <RotateTransform Angle="{Binding Value, ElementName=sliRotation}" />
                       </TransformGroup>
                   </TextBlock.RenderTransform>
        </TextBlock>

        

        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Label x:Name="lblFontsize" Content="Schriftgröße" />
            <TextBox x:Name="txbFontsize" Text="{Binding Value, ElementName=sliFontSize}" VerticalAlignment="Center" Width="50" TextAlignment="Center"/>
            <Label x:Name="lblRotation" Content="Drehwinkel" />
            <TextBox x:Name="txbRotation" Text="{Binding Value, ElementName=sliRotation, Mode=TwoWay}" VerticalAlignment="Center" Width="50" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
