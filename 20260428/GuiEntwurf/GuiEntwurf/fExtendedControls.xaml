<Window x:Class="GuiEntwurf.fExtendedControls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuiEntwurf"
        mc:Ignorable="d"
        Title="fExtendedControls" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_Datei" >
                <MenuItem Header="_Neu" />
                <MenuItem Header="_Öffnen" />
                <MenuItem Header="_Speichern" />
                <Separator/>
                <MenuItem Header="_Beenden" />
            </MenuItem>

            <MenuItem Header="_Bearbeiten" >
                <MenuItem Header="_Rückgängig" />
                <MenuItem Header="_Ausschneiden" />
                <MenuItem Header="_Kopieren" />
                <MenuItem Header="_Einfügen" />
                <Separator/>
                <MenuItem Header="_Suchen" />
            </MenuItem>
        </Menu>

        <TabControl Grid.Row="1">
            <TabItem Header="Tab 1">
                <Grid Background="Beige">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*"/>
                        <RowDefinition Height="50*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0" Background="Azure">
                      
                    </Grid>
                    
                    <Grid Grid.Row="0" Grid.Column="1" Background="Red">

                    </Grid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Tab 2">
                <Grid Background="Chartreuse"></Grid>
            </TabItem>

            <TabItem Header="Tab 3">
                <Grid Background="BlanchedAlmond"></Grid>
            </TabItem>

        </TabControl>


        <StatusBar Grid.Row="2">
            <StackPanel>
                <Label x:Name="lblStatus" Content="Ready" />
            </StackPanel>
        </StatusBar>

    </Grid>
</Window>
