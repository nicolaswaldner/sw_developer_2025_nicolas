<Window x:Class="GuiEntwurf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuiEntwurf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Button Content="Button" x:Name="btnDemo" Height="50" Width="100" Click="btnDemo_Click"/>
            <ComboBox x:Name="cbxDemo" Width="120" Background="#FFE6E6E6">
                <ComboBoxItem Content="Auswahl 1" IsSelected="True"/>
                <ComboBoxItem Content="Auswahl 2"/>
            </ComboBox>
            <ListBox x:Name="lstDemo" Width="120" Height="100" SelectionMode="Extended">
                <ListBoxItem Content="Wert 1"/>
                <ListBoxItem Content="Wert 2"/>
                <ListBoxItem Content="Wert 3"/>
                <ListBoxItem Content="Wert 4" IsSelected="True"/>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <RadioButton Content="Auswahl 1" GroupName="DemoGroup" IsChecked="True"/>
                <RadioButton Content="Auswahl 2" GroupName="DemoGroup"/>
                <RadioButton Content="Auswahl 3" GroupName="DemoGroup"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <CheckBox Content="Check 1" IsChecked="True" IsThreeState="True"/>
                <CheckBox Content="Check 2"/>
                <CheckBox Content="Check 3"/>
            </StackPanel> 

            <TextBox TextWrapping="Wrap" Text="TextBox" Width="120"/>
            <PasswordBox Password="Password" Width="120"/>

        </StackPanel>
        <Image Source="/exit-button-icon-215904-512.png" Margin="362,280,362,98" Width="50"/>
        <Label Content="Beschriftung" HorizontalAlignment="Center" FontSize="24" FontWeight="Black" Margin="0,228,0,-228"/>

    </Grid>
</Window>
