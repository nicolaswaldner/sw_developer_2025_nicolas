<Window x:Class="GuiEntwurf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuiEntwurf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Button Content="Button" x:Name="btnDemo"  Height="50" Width="100" Click="btnDemo_Click"/>
            <ComboBox x:Name="cbxDemo" Width="120" BorderBrush="#FFACACAC">
                <ComboBoxItem Content="Auswahl 1" IsSelected="True"/>
                <ComboBoxItem Content="Auswahl 2"/>
            </ComboBox>
            <ListBox x:Name="lstDemo" Width="120" SelectionMode="Extended" >
                <ListBoxItem Content="Wert 1"/>
                <ListBoxItem Content="Wert 2"/>
                <ListBoxItem Content="Wert 3"/>
                <ListBoxItem Content="Wert 4" IsSelected="True"/>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <RadioButton Content="Auswahl 1" GroupName="DemoGroup" IsChecked="True"/>
                <RadioButton Content="Auswahl 2" GroupName="DemoGroup"/>
                <RadioButton Content="Auswahl 3" GroupName="DemoGroup"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <CheckBox Content="Check 1" IsChecked="True" IsThreeState="True"/>
                <CheckBox Content="Check 2"/>
                <CheckBox Content="Check 3"/>
            </StackPanel>
            <Image Source="/Image/R.png" Width="50" />
            <Label Content="Beschriftung" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" />
            <TextBox x:Name="txtDemo" Width="200" Text="Text eingeben"/>

        </StackPanel>

    </Grid>
</Window>
