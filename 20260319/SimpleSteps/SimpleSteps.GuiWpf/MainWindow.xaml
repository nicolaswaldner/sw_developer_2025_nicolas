<Window x:Class="SimpleSteps.GuiWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleSteps.GuiWpf"
        mc:Ignorable="d"
        Title="SimpleSteps" Height="800" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="90*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="grdAppUsers" Grid.Column="1" Grid.Row="0" AutoGenerateColumns="True" />
        <DataGrid x:Name="grdLocations" Grid.Column="1" Grid.Row="1" AutoGenerateColumns="True" />
        <DataGrid x:Name="grdRooms" Grid.Column="1" Grid.Row="2" AutoGenerateColumns="True" />
        <DataGrid x:Name="grdRoomsByLocation" Grid.Column="1" Grid.Row="3" AutoGenerateColumns="True" />

        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Margin="5,10,5,10" x:Name="btnLoadAppUsers" Content="AppUsers laden" Width="150" Height="35" Click="btnLoadAppUsers_Click"  />
            <Button Margin="5 10 5 10" x:Name="btnLoadRooms" Content="Rooms laden" Width="150" Height="35"/>
        </StackPanel>

    </Grid>

</Window>
