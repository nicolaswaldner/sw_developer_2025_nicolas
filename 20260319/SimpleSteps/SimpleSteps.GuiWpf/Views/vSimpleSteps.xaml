<Window x:Class="SimpleSteps.GuiWpf.Views.vSimpleSteps"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleSteps.GuiWpf.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" x:Name="menMain">
            <MenuItem Header="Datei" >

            </MenuItem>

            <MenuItem Header="Bearbeiten" >

            </MenuItem>

            <MenuItem Header="Hilfe" >

            </MenuItem>
        </Menu>

        <TabControl Grid.Row="1" x:Name="tabMain">
            <TabItem Header="Dashboard" >
                <StackPanel>
                    <Label x:Name="lblRaumklima" Content="Raumklima" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <DataGrid x:Name="dgRoomData" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding Property1}" />
                            <DataGridTextColumn Header="Raum" Binding="{Binding Property2}" />
                            <DataGridTextColumn Header="Raumtemperatur" Binding="{Binding Property3}" />
                            <DataGridTextColumn Header="Co2" Binding="{Binding Property4}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

            </TabItem>

            <TabItem Header="Daten">

            </TabItem>

            <TabItem Header="Klienten">
                
            </TabItem>
            
            <TabItem Header="Vorhersage">

            </TabItem>

        </TabControl>


        <StatusBar Grid.Row="2" x:Name="staStatusbar">
            <StackPanel Orientation="Horizontal">
                <Label Content="Datenstand vom:" />
                <Label x:Name="lblLastData" Content="{Binding LastData}" />
                <Label Content="Letzte Aktualisierung:" />
                <Label x:Name="lblLastForecast" Content="{Binding LastForecast}" />
            </StackPanel>
        </StatusBar>





    </Grid>
</Window>
