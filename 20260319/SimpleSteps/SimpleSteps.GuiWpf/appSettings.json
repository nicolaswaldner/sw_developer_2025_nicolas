{
  "ConnectionStrings": {
    "DefaultConnection": "Server=Developer-11\\MSSQLSERVER2025;Database=SimpleSteps;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/simplesteps-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  //"Logging": {
  //  "LogLevel": {
  //    "Default": "Warning",
  //    "Microsoft.EntityFrameworkCore.Database.Command": "Information"
  //  }
  //},
  "AppSettings": {
    "ApplicationName": "SimpleSteps",
    "MaxItems": 100
  },

  "WeatherSettings": {
    "DefaultProvider": "OpenMeteo",
    "Language": "de",
    "Units": "metric",
    "TimeoutSeconds": 30,
    "DefaultLocation": {
      "Name": "Lustenau, Österreich",
      "Latitude": 47.4264,
      "Longitude": 9.6585
    },
    "OpenWeatherMap": {
      "BaseUrl": "https://api.openweathermap.org",
      "ApiKey": "",
      "OneCallVersion": "4.0"
    },
    "OpenMeteo": {
      "BaseUrl": "https://api.open-meteo.com",
      "RequiresApiKey": false
    }
  }
}